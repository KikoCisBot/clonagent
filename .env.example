# ── LLM (one of these two) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3300
CLONAGENT_MODEL=claude-opus-4-7
PUBLIC_URL=https://clonagent.example.com

# ── Agent relay (host-relay from agent-manager) ─────────────────────────────
AGENT_RELAY_URL=http://localhost:3201

# ── Auth ────────────────────────────────────────────────────────────────────
# AUTH_MODE=basic        # none | basic | oidc  (default: basic)
# ALLOW_REGISTRATION=0   # set to 0 to disable open registration

# ── Stripe billing ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=    # Price ID for $29/month plan
STRIPE_PRICE_PRO=         # Price ID for $99/month plan

# ── Email (transactional) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=ClonAgent
# Alternative: SENDGRID_API_KEY=

# ── Gitea integration (optional) ────────────────────────────────────────────
GITEA_URL_INTERNAL=http://localhost:3200
GITEA_TOKEN=
GITEA_ADMIN_USER=
